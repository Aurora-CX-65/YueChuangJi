# ============================================
# 阅创集 (YueChuangJi) Docker 环境变量配置
# ============================================
# 使用方式:
#   1. 复制此文件: cp .env.docker .env
#   2. 修改 .env 中的敏感信息（密码、API Key 等）
#   3. 启动: docker compose up -d
#   4. 生产模式: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# ⚠️  警告: .env 文件包含敏感信息，请勿提交到版本控制！
# ============================================

# ---- 应用版本 ----
APP_VERSION=1.0.0

# ---- 部署模式 ----
# local: 本地开发（数据库/Redis 端口暴露、HTTP 访问）
# production: 生产部署（中间件端口不暴露、HTTPS 支持）
DEPLOY_MODE=local

# ---- 公网访问配置 ----
# 如果通过域名访问，填写域名（如 yuechuangji.com）
# 如果通过 IP 访问，填写公网 IP（如 123.45.67.89）
# 本地开发保持 localhost
PUBLIC_DOMAIN=localhost
PUBLIC_IP=

# ---- HTTPS/SSL 配置 ----
# 是否启用 HTTPS（需要有效的 SSL 证书）
# 设为 true 后，需要将证书文件放到 docker/nginx/ssl/ 目录
#   - fullchain.pem: 证书链文件
#   - privkey.pem: 私钥文件
ENABLE_SSL=false
HTTPS_PORT=443

# ---- 数据库配置 ----
DB_NAME=yuechuangji
DB_ROOT_PASSWORD=ChangeMe123!
# 是否向外暴露数据库端口（生产环境请设为 false）
DB_EXPOSE_PORT=3306

# ---- Redis 配置 ----
# 生产环境务必设置密码！
REDIS_PASSWORD=
# 是否向外暴露 Redis 端口（生产环境请设为 false）
REDIS_EXPOSE_PORT=6379

# ---- 后端端口 ----
BACKEND_EXPOSE_PORT=8080

# ---- 前端端口 ----
FRONTEND_EXPOSE_PORT=80

# ---- 前端 API 地址 ----
# Nginx 反向代理模式（推荐）: /api
# 独立跨域模式: http://your-server:8080
VITE_API_BASE_URL=/api

# ---- 文件访问基础 URL ----
# 上传文件的外部访问地址
# 本地开发：http://localhost
# 公网部署：http://your-domain.com 或 http://your-public-ip
FILE_ACCESS_BASE_URL=http://localhost

# ---- 前端应用标题 ----
VITE_APP_TITLE=阅创集

# ---- JWT 密钥 ----
# 生产环境务必替换为随机字符串！
# 生成方式: openssl rand -base64 64
JWT_SECRET=yuechuangji-jwt-secret-key-2025-for-authentication-and-authorization

# ---- 邮件服务配置（可选） ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- DeepSeek AI 配置（可选） ----
DEEPSEEK_API_KEY=
